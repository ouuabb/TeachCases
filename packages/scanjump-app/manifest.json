{
    "name" : "ScanJumpApp",
    "appid" : "__UNI__45DBE79",
    "description" : "扫码跳 App 路由教学案例 — 覆盖 6 种 DeepLink 方案",
    "versionName" : "1.0.0",
    "versionCode" : "100",
    "transformPx" : false,

    /* ============================================
     * 5+App 特有配置
     * ============================================ */
    "app-plus" : {
        "usingComponents" : true,
        "nvueStyleCompiler" : "uni-app",
        "compilerVersion" : 3,
        "splashscreen" : {
            "alwaysShowBeforeRender" : true,
            "waiting" : true,
            "autoclose" : true,
            "delay" : 0
        },

        /* 模块配置 */
        "modules" : {},

        /* ============================================
         * 应用发布信息
         *
         * 教学要点：
         * - schemes：自定义 URL Scheme（方案一）
         * - intentFilters：Android App Link 配置（方案二）
         * - universalLinks：iOS Universal Link 配置（方案二）
         * ============================================ */
        "distribute" : {
            /* Android 打包配置 */
            "android" : {
                "permissions" : [
                    "<uses-permission android:name=\"android.permission.CHANGE_NETWORK_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.MOUNT_UNMOUNT_FILESYSTEMS\"/>",
                    "<uses-permission android:name=\"android.permission.VIBRATE\"/>",
                    "<uses-permission android:name=\"android.permission.READ_LOGS\"/>",
                    "<uses-permission android:name=\"android.permission.ACCESS_WIFI_STATE\"/>",
                    "<uses-feature android:name=\"android.hardware.camera.autofocus\"/>",
                    "<uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.CAMERA\"/>",
                    "<uses-permission android:name=\"android.permission.GET_ACCOUNTS\"/>",
                    "<uses-permission android:name=\"android.permission.READ_PHONE_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.CHANGE_WIFI_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.WAKE_LOCK\"/>",
                    "<uses-permission android:name=\"android.permission.FLASHLIGHT\"/>",
                    "<uses-feature android:name=\"android.hardware.camera\"/>",
                    "<uses-permission android:name=\"android.permission.WRITE_SETTINGS\"/>"
                ],

                /* ============================================
                 * 方案一：URL Scheme 配置
                 *
                 * 扫描 scanjump://page/detail?id=123 时唤起本 App
                 * 需要与 utils/config.js 中的 SCHEME_NAME 一致
                 * ============================================ */
                "schemes" : [
                    "scanjump"
                ],

                /* ============================================
                 * 方案二：Android App Link 配置
                 *
                 * intentFilters 定义 App 能响应的 Intent
                 * 配合 assetlinks.json 域名验证使用
                 * ============================================ */
                "intentFilters" : [
                    {
                        "action" : "android.intent.action.VIEW",
                        "data" : {
                            "scheme" : "https",
                            "host" : "app.example.com"
                        }
                    },
                    {
                        "action" : "android.intent.action.VIEW",
                        "data" : {
                            "scheme" : "scanjump"
                        }
                    }
                ]
            },

            /* iOS 打包配置 */
            "ios" : {
                /* ============================================
                 * 方案一：iOS URL Types 配置
                 *
                 * 定义 App 支持的自定义协议
                 * ============================================ */
                "urltypes" : [
                    {
                        "urlschemes" : [
                            "scanjump"
                        ]
                    }
                ],

                /* ============================================
                 * 方案二：iOS Universal Links 配置
                 *
                 * 配合 apple-app-site-association 域名验证
                 * ============================================ */
                "universalLinks" : [
                    "https://app.example.com/ul/"
                ]
            },

            /* SDK 配置 */
            "sdkConfigs" : {}
        }
    },

    /* 快应用特有相关 */
    "quickapp" : {},

    /* ============================================
     * 小程序特有相关
     *
     * 微信小程序有自己的扫码 API（wx.scanCode），
     * 与 App DeepLink 是不同的实现方式。
     * ============================================ */
    "mp-weixin" : {
        "appid" : "",
        "setting" : {
            "urlCheck" : false
        },
        "usingComponents" : true
    },
    "mp-alipay" : {
        "usingComponents" : true
    },
    "mp-baidu" : {
        "usingComponents" : true
    },
    "mp-toutiao" : {
        "usingComponents" : true
    },

    /* Vue 版本 */
    "vueVersion" : "3"
}
